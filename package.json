{
  "name": "decky-agent-remote",
  "version": "0.4.1",
  "description": "Talk to remote DSH agents from Steam Deck Gaming Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "node --test bridge/*.test.mjs tests/*.test.ts && python3 -m unittest discover -s tests -p 'test_*.py'",
    "typecheck": "tsc --noEmit",
    "bridge": "node bridge/server.mjs",
    "bridge:init": "node bridge/configure.mjs",
    "package": "python3 scripts/package.py",
    "check:public": "python3 scripts/check_public.py",
    "preview": "pnpm build && node preview/server.mjs"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "dsh",
    "voice",
    "remote-agent"
  ],
  "author": "kongdayan",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "^5.1.20",
    "@types/webpack": "^5.28.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "opencc-js": "^1.4.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "pnpm@10.19.0"
}
